# =============================================================================
# LTTS Environment Variables
# =============================================================================
# Copy this file to .env and customize for your deployment.

# --- Server ---
# 127.0.0.1 keeps the server on this machine. The server executes module code
# and has no authentication - only bind 0.0.0.0 inside a container or tunnel.
LTTS_HOST=127.0.0.1
LTTS_PORT=8000

# --- Logging ---
# Options: DEBUG, INFO, WARNING, ERROR
LTTS_LOG_LEVEL=INFO

# --- CORS ---
# Comma-separated list of allowed origins. Leave empty for defaults (localhost).
LTTS_ALLOWED_ORIGINS=

# --- HuggingFace ---
# Required for private models. Get a token at https://huggingface.co/settings/tokens
HF_TOKEN=

# --- Modules ---
# Directory analysis modules are loaded from. Resolution order when unset:
# a sibling ../LTTS-modules checkout, then ./ltts_modules (API-installed).
# LTTS_MODULES_DIR=../LTTS-modules

# --- Module registry ---
# Where to find the LTTS-modules registry: an http(s) URL to registry.json
# (e.g., GitHub raw) or a local path (a checkout of the LTTS-modules repo).
# When unset, LTTS looks for a sibling ../LTTS-modules/registry.json checkout.
# LTTS_MODULES_REGISTRY=https://raw.githubusercontent.com/seruva19/LTTS-modules/main/registry.json
# LTTS_MODULES_REGISTRY=../LTTS-modules/registry.json

# Where analysis modules are loaded from. Modules live only in the
# LTTS-modules repository - no copies. Default: sibling ../LTTS-modules
# checkout; falls back to ./ltts_modules (install target of the registry UI).
# LTTS_MODULES_DIR=../LTTS-modules

# Allow installing third-party modules from a remote registry via the API.
# WARNING: installed modules run arbitrary Python code inside the server process.
LTTS_ALLOW_MODULE_INSTALL=

# --- Python path (dev convenience) ---
# Semicolon-separated on Windows, colon-separated on Linux/macOS.
# PYTHONPATH=.;scripts;miners;ltts_modules

# --- Frontend (Vite) ---
# Dev-only overrides, used when the Vite dev server talks to a backend that is
# not on localhost:8000. Leave these UNSET for production builds: a built SPA
# uses same-origin relative URLs so it works behind Colab/SSH port proxies.
# VITE_LTTS_HOST=localhost:8000
# VITE_LTTS_BASE_URL=http://localhost:8000
